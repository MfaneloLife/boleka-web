{
  "version": 2,
  "buildCommand": "npx prisma generate && npx prisma db push --skip-generate && npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://eboleka.co.za",
    "GCE_METADATA_HOST": "disabled",
    "R2_BUCKET_NAME": "bolekaweb",
    "R2_PUBLIC_URL": "https://pub-0bf9994c37384a93b6f02dc5dc60ec44.r2.dev"
  },
  "crons": [
    {
      "path": "/api/cron/process-payouts",
      "schedule": "0 2 * * 2"
    },
    {
      "path": "/api/items/weekly-refresh",
      "schedule": "0 0 * * 1"
    }
  ]
}
